{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Purrzip",
  "version": "0.1.0",
  "identifier": "io.gmcat.purrzip",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Purrzip",
        "width": 900,
        "height": 720,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; frame-src asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPCACHE/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "app",
      "appimage",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 26
    },
    "publisher": "GmCat",
    "copyright": "\u00a9 2026 GmCat",
    "category": "Utility",
    "shortDescription": "Open and make archives",
    "longDescription": "Purrzip by GmCat opens .zip, .7z, .rar, .tar, .gz and more, and makes .zip and .7z archives. Free, no ads, no account, no tracking.",
    "licenseFile": "../../LICENSE",
    "fileAssociations": [
      {
        "ext": [
          "zip"
        ],
        "name": "ZIP archive",
        "role": "Editor",
        "mimeType": "application/zip"
      },
      {
        "ext": [
          "7z"
        ],
        "name": "7z archive",
        "role": "Editor",
        "mimeType": "application/x-7z-compressed"
      },
      {
        "ext": [
          "rar"
        ],
        "name": "RAR archive",
        "role": "Viewer",
        "mimeType": "application/vnd.rar"
      },
      {
        "ext": [
          "tar",
          "tgz",
          "gz",
          "bz2",
          "xz",
          "zst",
          "tbz2",
          "txz"
        ],
        "name": "TAR / compressed file",
        "role": "Viewer"
      },
      {
        "ext": [
          "iso",
          "cab"
        ],
        "name": "Disc image / cabinet",
        "role": "Viewer"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}